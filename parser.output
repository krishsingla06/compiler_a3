  145                    | XOR_ASSIGN
  146                    | OR_ASSIGN

  147 expression: assignment_expression
  148           | expression COMMA assignment_expression

  149 constant_expression: conditional_expression

  150 struct_or_union_specifier: struct_or_union IDENTIFIER LBRACE struct_declaration_list RBRACE
  151                          | struct_or_union IDENTIFIER

  152 struct_or_union: STRUCT
  153                | UNION
  154                | CLASS

  155 struct_declaration_list: struct_declaration
  156                        | struct_declaration_list struct_declaration

  157 struct_declaration: specifier_qualifier_list struct_declarator_list SEMICOLON

  158 specifier_qualifier_list: type_specifier specifier_qualifier_list
  159                         | type_specifier
  160                         | type_qualifier specifier_qualifier_list
  161                         | type_qualifier

  162 struct_declarator_list: struct_declarator
  163                       | struct_declarator_list COMMA struct_declarator

  164 struct_declarator: declarator
