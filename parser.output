   46 parameter_list: parameter_declaration
   47               | parameter_list COMMA parameter_declaration

   48 parameter_declaration: return_types declarator

   49 class_declaration: CLASS IDENTIFIER opt_base_clause LBRACE class_body RBRACE SEMICOLON

   50 opt_base_clause: ε
   51                | COLON base_specifier_list

   52 base_specifier_list: base_specifier
   53                    | base_specifier_list COMMA base_specifier

   54 base_specifier: opt_access_specifier IDENTIFIER

   55 opt_access_specifier: ε
   56                     | PUBLIC
   57                     | PROTECTED
   58                     | PRIVATE

   59 class_body: ε
   60           | class_body member_declaration

   61 member_declaration: declaration
   62                   | statement_list
   63                   | function_definition
   64                   | access_label
   65                   | class_declaration
   66                   | constructor_declaration
   67                   | destructor_declaration

   68 constructor_declaration: IDENTIFIER LPAREN parameter_list RPAREN compound_statement

   69 destructor_declaration: BIT_NOT IDENTIFIER LPAREN RPAREN compound_statement

   70 access_label: PUBLIC COLON
   71             | PROTECTED COLON
   72             | PRIVATE COLON

   73 primary_expression: IDENTIFIER
   74                   | INT_LITERAL
   75                   | FLOAT_LITERAL
   76                   | CHAR_LITERAL
   77                   | STRING_LITERAL
   78                   | NULL_LITERAL
   79                   | BOOLEAN_LITERAL
   80                   | LPAREN expression RPAREN

   81 postfix_expression: primary_expression
   82                   | postfix_expression LBRACKET expression RBRACKET
   83                   | postfix_expression LPAREN RPAREN
   84                   | postfix_expression LPAREN argument_expression_list RPAREN
   85                   | postfix_expression DOT IDENTIFIER
   86                   | postfix_expression ARROW IDENTIFIER
   87                   | postfix_expression INCREMENT
   88                   | postfix_expression DECREMENT

   89 argument_expression_list: assignment_expression
   90                         | argument_expression_list COMMA assignment_expression

   91 unary_expression: postfix_expression
   92                 | INCREMENT unary_expression
   93                 | DECREMENT unary_expression
   94                 | unary_operator cast_expression
   95                 | SIZEOF unary_expression
   96                 | SIZEOF LPAREN type_name RPAREN

   97 unary_operator: BIT_AND
   98               | STAR
   99               | PLUS
  100               | MINUS
  101               | BIT_NOT
  102               | LOGICAL_NOT

  103 cast_expression: unary_expression
  104                | LPAREN type_name RPAREN cast_expression

  105 multiplicative_expression: cast_expression
  106                          | multiplicative_expression STAR cast_expression
  107                          | multiplicative_expression DIVIDE cast_expression
  108                          | multiplicative_expression MOD cast_expression

  109 additive_expression: multiplicative_expression
  110                    | additive_expression PLUS multiplicative_expression
  111                    | additive_expression MINUS multiplicative_expression

  112 shift_expression: additive_expression
  113                 | shift_expression LEFT_SHIFT additive_expression
  114                 | shift_expression RIGHT_SHIFT additive_expression

  115 relational_expression: shift_expression
  116                      | relational_expression LT shift_expression
  117                      | relational_expression GT shift_expression
  118                      | relational_expression LE shift_expression
  119                      | relational_expression GE shift_expression

  120 equality_expression: relational_expression
  121                    | equality_expression EQ relational_expression
  122                    | equality_expression NEQ relational_expression

  123 and_expression: equality_expression
